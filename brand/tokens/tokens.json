    "duration": {
      "instant": 100,
      "fast": 150,
      "base": 200,
      "moderate": 300,
      "slow": 450,
      "deliberate": 600,
      "shimmer": 1400
    },
    "easing": {
      "standard": [
        0.2,
        0.0,
        0.0,
        1.0
      ],
      "enter": [
        0.0,
        0.0,
        0.0,
        1.0
      ],
      "exit": [
        0.3,
        0.0,
        1.0,
        1.0
      ],
      "emphasized": [
        0.3,
        0.0,
        0.0,
        1.0
      ],
      "linear": [
        0.0,
        0.0,
        1.0,
        1.0
      ]
    },
    "spring": {
      "snappy": {
        "response": 0.3,
        "damping": 0.86
      },
      "smooth": {
        "response": 0.45,
        "damping": 1.0
      },
      "bouncy": {
        "response": 0.5,
        "damping": 0.7
      }
    },
    "patterns": {
      "press": {
        "duration": "instant",
        "easing": "standard",
        "spec": "scale 1 → 0.97, overlay +12%; release springs back (snappy)"
      },
      "hover": {
        "duration": "fast",
        "easing": "standard",
        "spec": "overlay +6%, shadow e1 → e2"
      },
      "fade": {
        "duration": "fast",
        "easing": "standard",
        "spec": "opacity only — tooltips, toasts out, swaps"
      },
      "expand": {
        "duration": "base",
        "easing": "standard",
        "spec": "accordions, chips, inline validation"
      },
      "pageEnter": {
        "duration": "moderate",
        "easing": "emphasized",
        "spec": "slide 24px + fade in; platform-native push on iOS/Android"
      },
      "pageExit": {
        "duration": "base",
        "easing": "exit",
        "spec": "fade out + 8px slide"
      },
      "sheetEnter": {
        "duration": "moderate",
        "easing": "enter",
        "spec": "bottom sheet / dialog rises from 100% → 0, scrim fades to 48%"
      },
      "sheetExit": {
        "duration": "base",
        "easing": "exit",
        "spec": "reverse of sheetEnter, faster"
      },
      "toast": {
        "duration": "moderate",
        "easing": "emphasized",
        "spec": "drop 16px + fade; auto-dismiss 4s"
      },
      "success": {
        "duration": "deliberate",
        "easing": "emphasized",
        "spec": "payment success: circle scales 0.6→1 (bouncy), check stroke draws, coral sparks burst once"
      },
      "skeleton": {
        "duration": "shimmer",
        "easing": "linear",
        "spec": "left→right sheen, infinite; replaced by content with fade"
      },
      "numberTick": {
        "duration": "slow",
        "easing": "standard",
        "spec": "amounts/balances count to new value, tabular figures"
      }
    },
    "reducedMotion": "When the OS requests reduced motion: replace slides/scales with opacity fades ≤150ms, disable shimmer (static placeholder), disable sparks and number ticks."
  },
